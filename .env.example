# Optional settings for local monitoring. Copy values into your user environment or a private .env
# and load them before starting the monitor. This file contains placeholders only.
YASHIPDF_SITE_URL=https://www.yashipdf.online/
YASHIPDF_HOST=127.0.0.1
YASHIPDF_PORT=8765
YASHIPDF_DATA_DIR=monitor/data
YASHIPDF_MAX_URLS=250
YASHIPDF_AUDIT_INTERVAL_MINUTES=1440
YASHIPDF_RETRY_INTERVAL_MINUTES=15
YASHIPDF_REQUEST_TIMEOUT=12
YASHIPDF_REQUEST_RETRIES=2
YASHIPDF_CRAWL_DELAY_SECONDS=0.2
YASHIPDF_API_DELAY_SECONDS=1
YASHIPDF_LOCAL_NOTIFY=1
YASHIPDF_ALERT_FILE=monitor/data/alerts.jsonl

# Google Search Console OAuth 2.0. Requires webmasters.readonly permission and verified property access.
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-oauth-refresh-token
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:yashipdf.online

# Bing Webmaster documented JSON/HTTP read endpoints (API key or OAuth read scope).
BING_WEBMASTER_API_KEY=your-bing-webmaster-api-key
BING_WEBMASTER_SITE_URL=https://www.yashipdf.online/
# Optional OAuth alternative to the API key. Use read scope only.
BING_WEBMASTER_CLIENT_ID=your-bing-oauth-client-id
BING_WEBMASTER_CLIENT_SECRET=your-bing-oauth-client-secret
BING_WEBMASTER_REFRESH_TOKEN=your-bing-oauth-refresh-token
