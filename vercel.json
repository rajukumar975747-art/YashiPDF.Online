{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/feeds/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/([0-9]{4})/([0-9]{2})/:slug.html",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/posts.json",
      "destination": "/posts.json"
    }
  ],
  "headers": [
    {
      "source": "/posts.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
