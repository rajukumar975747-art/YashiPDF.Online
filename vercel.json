{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/feeds/:path*", "destination": "/", "permanent": true },
    { "source": "/:year(\\d{4})/:month(\\d{2})/:slug.html", "destination": "/blog/:slug", "permanent": true },
    { "source": "/:year(\\d{4})/:month(\\d{2})/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/:path*\\?m=1", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/posts.json", "destination": "/posts.json" }
  ],
  "headers": [
    {
      "source": "/blog/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/posts.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}